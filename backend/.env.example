# AI Provider Selection ("groq", "nvidia", or "openrouter")
AI_PROVIDER=nvidia

# Core Paths
INPUT_DIR=./input/images
OUTPUT_DIR=./output
REFERENCE_PPT=./input/reference.pptx
REMOVE_BG=false

# Redis Configuration (For Celery and WebSockets)
REDIS_URL=redis://localhost:6379/0

# NVIDIA NIM Configs
NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/llama-3.2-nv-vision-72b-instruct

# Groq Configs
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.2-90b-vision-preview
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview

# OpenRouter Configs
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=google/gemini-flash-2.5
