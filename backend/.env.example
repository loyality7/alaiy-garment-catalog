# AI Provider Selection ("gemini" or "openrouter")
AI_PROVIDER=gemini

# Core Paths
INPUT_DIR=./input/images
OUTPUT_DIR=./output
REFERENCE_PPT=./input/reference.pptx
REMOVE_BG=false

# Redis Configuration (For Celery and WebSockets)
REDIS_URL=redis://localhost:6379/0

# OpenRouter Configs
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=google/gemini-flash-2.5
BATCH_GAP_THRESHOLD=60
ENABLE_CONFIRMATION_PASS=true

# Gemini Provider
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models